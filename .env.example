# ── Core ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# ── Supabase (Auth + Postgres + PostGIS) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-EXPOSE-TO-BROWSER
DATABASE_URL=postgresql://postgres:password@localhost:5432/turf
DIRECT_URL=postgresql://postgres:password@localhost:5432/turf

# ── Redis / BullMQ ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay (mock adapter used when absent) ──────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Maps (google | mapbox) ────────────────────────────
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ── Push (Web Push / VAPID) ───────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Email / SMS (adapters; mock when absent) ──────────
# mock  = log messages (incl. password-reset links) to the API console
# resend = deliver via Resend (requires RESEND_API_KEY + verified EMAIL_FROM)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Turf <onboarding@resend.dev>
SMS_PROVIDER=mock

# ── Platform ──────────────────────────────────────────
PLATFORM_NAME=Turf
SUPPORT_EMAIL=support@example.com
CORS_ORIGINS=http://localhost:3000

