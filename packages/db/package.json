{
  "name": "@turf/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit -p tsconfig.json",
    "db:generate": "echo 'migrations are hand-authored SQL in packages/db/migrations'",
    "db:migrate": "tsx src/migrate.ts up",
    "db:rollback": "tsx src/migrate.ts down",
    "db:seed": "tsx seed/seed.ts",
    "db:push": "echo 'use db:migrate; push is unsafe for shared envs'"
  },
  "dependencies": {
    "@turf/config": "*",
    "@turf/shared-types": "*",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
